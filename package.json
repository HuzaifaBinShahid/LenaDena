{
  "name": "lenadena",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @lenadena/frontend --filter @lenadena/backend dev",
    "dev:frontend": "pnpm --filter @lenadena/frontend dev",
    "dev:backend": "pnpm --filter @lenadena/backend dev",
    "dev:worker": "pnpm --filter @lenadena/backend worker:dev",
    "worker": "pnpm --filter @lenadena/backend worker",
    "build": "pnpm build:backend && pnpm build:web",
    "build:backend": "pnpm --filter @lenadena/backend build",
    "build:web": "pnpm --filter @lenadena/frontend exec expo export --platform web --output-dir dist-web",
    "doctor": "pnpm --filter @lenadena/frontend run doctor",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
