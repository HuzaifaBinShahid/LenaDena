NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=*
AUTH_MODE=demo
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LenaDena <hello@example.com>
NOTIFICATION_INTERVAL_MS=30000
# Hosted email worker: enables POST /internal/notifications/run (a scheduler calls it every minute). At least 32
# characters, e.g. `openssl rand -hex 32`. Leave empty to keep the route off. See documentation/DEPLOYMENT.md.
NOTIFICATIONS_CRON_SECRET=
# Off by default: LenaDena only emails people it was asked to. true re-enables the automatic group-debt reminders
# (every 72 hours to each group member who still owes). Reminders an owner switches on per person always run.
ENABLE_GROUP_DEBT_REMINDERS=false
# Optional: hosted logo for notification emails (default: the bundled PNG, attached inline).
EMAIL_LOGO_URL=
# Optional: https base that serves the app's routes, so email buttons work in Gmail (it strips lenadena:// links).
EMAIL_LINK_BASE_URL=
# Optional: https link to install the app (e.g. the Loadly page for the Android APK), used in person invite emails.
# Overrides the link the app suggests; without either, invite emails ask the person to get the link from you.
APP_DOWNLOAD_URL=
# Public contact details for the privacy policy (/privacy) and account deletion (/delete-account) pages. Both are shown
# to anyone, so use an address you are happy to publish and read. Without SUPPORT_EMAIL the pages say no address is
# published yet, and deletion requests by email are not offered. OPERATOR_NAME is the person or company running the app.
SUPPORT_EMAIL=
OPERATOR_NAME=
# Optional, backend-only: enables the authenticated voice-entry transcription endpoint.
# Create this in Deepgram Console → API Keys. Never put it in frontend/.env or any EXPO_PUBLIC_* variable.
DEEPGRAM_API_KEY=replace_with_your_deepgram_api_key
# Optional, backend-only: push notifications through Firebase Cloud Messaging (reminders and group invitations).
# Firebase console -> Project settings -> Service accounts -> Generate new private key; paste the whole JSON here (or that JSON
# in base64). Never commit it, and never put it in frontend/.env or any EXPO_PUBLIC_* variable. Without it pushes are off and
# the app shares a message instead. The matching Android file goes at frontend/google-services.json (see documentation/DEPLOYMENT.md).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional: a request at least this many milliseconds slow is logged as a warning, with the calls (database, Auth, Firebase)
# that took the time. Default 1500, minimum 100. Vercel stops a function after 10 seconds on the free plan.
SLOW_REQUEST_MS=
