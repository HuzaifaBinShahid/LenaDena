NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=*
AUTH_MODE=demo
# Development only: create/sign in accounts with just an email (no verification). Ignored when NODE_ENV=production.
ALLOW_INSTANT_AUTH=true
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LenaDena <hello@example.com>
NOTIFICATION_INTERVAL_MS=30000
# Optional: hosted logo for notification emails (default: the bundled PNG, attached inline).
EMAIL_LOGO_URL=
# Optional: https base that serves the app's routes, so email buttons work in Gmail (it strips lenadena:// links).
EMAIL_LINK_BASE_URL=
# Optional: https link to install the app (e.g. the Loadly page for the Android APK), used in person invite emails.
# Overrides the link the app suggests; without either, invite emails ask the person to get the link from you.
APP_DOWNLOAD_URL=
